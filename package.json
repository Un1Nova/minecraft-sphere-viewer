{
  "name": "minecraft-sphere-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Сфера 196: строительные слои, каркас XYZ, подсчёт блоков и стаков.",
  "scripts": {
    "dev": "vite --config builder/vite.config.mjs --host 0.0.0.0 --port 4173",
    "build": "vite build --config builder/vite.config.mjs",
    "preview": "vite preview --config builder/vite.config.mjs --host 0.0.0.0 --port 4173",
    "test": "node --import tsx --test tests/*.test.ts && node --test builder/tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1", "three": "0.186.1" },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
